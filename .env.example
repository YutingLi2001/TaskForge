# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskforge
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/taskforge

# JWT Secret (change in production)
SECRET_KEY=your-secret-key-here-change-in-production

# Frontend URL(s) (for CORS)
FRONTEND_URL=http://localhost
FRONTEND_URLS=http://localhost,http://127.0.0.1

# Frontend API base URL (for Vite build)
VITE_API_BASE_URL=/api

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Remember me refresh token expiration (days)
REMEMBER_ME_REFRESH_DAYS=30

# Login rate limiting
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Account lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
